{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-api",
      "command": "dotnet",
      "type": "shell",
      "args": ["build", "LecturerManager.Api/LecturerManager.Api.csproj"],
      "problemMatcher": "$msCompile",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false
      }
    },
    {
      "label": "serve-frontend",
      "command": "cmd",
      "type": "shell",
      "args": ["/c", "cd lecturer-manager-frontend && ng serve --open=false"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\s*Angular 18+ development server.*",
          "endsPattern": "^\\s*Application bundle generation complete\\."
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false
      }
    },
    {
      "label": "build-and-serve",
      "dependsOn": ["build-api", "serve-frontend"],
      "problemMatcher": [],
      "presentation": {
        "echo": false,
        "reveal": "silent",
        "focus": false
      }
    },
    {
      "label": "ef-add-migration",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "ef",
        "migrations",
        "add",
        "${input:migrationName}",
        "--project",
        "LecturerManager.Infrastructure/LecturerManager.Infrastructure.csproj",
        "--startup-project",
        "LecturerManager.Api/LecturerManager.Api.csproj",
        "--context",
        "ApplicationDbContext",
        "--output-dir",
        "Persistence/Migrations"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true
      }
    },
    {
      "label": "ef-update-database",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "ef",
        "database",
        "update",
        "--project",
        "LecturerManager.Infrastructure/LecturerManager.Infrastructure.csproj",
        "--startup-project",
        "LecturerManager.Api/LecturerManager.Api.csproj",
        "--context",
        "ApplicationDbContext"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true
      }
    },
    {
      "label": "ef-remove-last-migration",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "ef",
        "migrations",
        "remove",
        "--project",
        "LecturerManager.Infrastructure/LecturerManager.Infrastructure.csproj",
        "--startup-project",
        "LecturerManager.Api/LecturerManager.Api.csproj",
        "--context",
        "ApplicationDbContext"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true
      }
    }
  ],
  "inputs": [
    {
      "id": "migrationName",
      "type": "promptString",
      "description": "Podaj nazwe migracji (np. AddCourseTable)",
      "default": "Init"
    }
  ]
}
